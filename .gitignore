# ==========================================
# FarmRent Git Ignore
# ==========================================

# -------------------------
# Operating System
# -------------------------

.DS_Store
Thumbs.db
desktop.ini


# -------------------------
# IDE / Editors
# -------------------------

.vscode/
.idea/
*.swp
*.swo


# -------------------------
# Environment / Secrets
# -------------------------

.env
.env.*
!.env.example


# -------------------------
# Logs
# -------------------------

*.log
logs/


# -------------------------
# Temporary Files
# -------------------------

*.tmp
*.temp
*.bak


# -------------------------
# Node.js
# -------------------------

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*


# -------------------------
# Python
# -------------------------

__pycache__/
*.py[cod]
*.pyo
*.pyd

venv/
.venv/
env/
ENV/


# -------------------------
# Database / Local Data
# -------------------------

*.sqlite
*.sqlite3

# Local database dumps
*.dump


# -------------------------
# Generated Files
# -------------------------

dist/
build/
coverage/


# -------------------------
# Local Uploads
# -------------------------

uploads/

# Keep project asset folders,
# but ignore temporary uploaded files.
frontend/assets/uploads/


# -------------------------
# Personal Notes
# -------------------------

*.notes
*.local